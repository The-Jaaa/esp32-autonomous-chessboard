{
  "name": "chess-companion-app",
  "version": "1.0.0",
  "description": "Companion app for autonomous chessboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test:physical-planner": "node scripts/physical-planner-regression.js",
    "test:physical-state": "node scripts/physical-state-regression.js",
    "test:physical": "npm run test:physical-planner && npm run test:physical-state",
    "test:offline-rules": "node scripts/offline-chess-rules-regression.js",
    "test:offline-physical": "node scripts/offline-physical-regression.js",
    "test:offline-engine": "node scripts/offline-engine-regression.js",
    "test:offline-coordinator": "node scripts/offline-coordinator-regression.js",
    "test:offline-integration": "node scripts/offline-integration-regression.js --quick",
    "test:offline-soak": "node scripts/offline-integration-regression.js --soak",
    "test:offline-route": "node scripts/offline-route-regression.js",
    "test:offline-external-route": "node scripts/offline-external-route-regression.js",
    "test:offline-motion": "node scripts/offline-motion-regression.js",
    "test:offline-motion-execution": "node scripts/offline-motion-execution-regression.js",
    "test:offline-ownership": "node scripts/offline-ownership-regression.js",
    "test:offline-runtime": "node scripts/offline-runtime-regression.js",
    "test:offline-phase-execution": "node scripts/offline-phase-execution-regression.js",
    "test:offline-quiet-motion": "node scripts/offline-quiet-motion-regression.js",
    "test:offline-capture-motion": "node scripts/offline-capture-motion-regression.js",
    "test:offline-staged-capture-motion": "node scripts/offline-capture-motion-regression.js",
    "test:offline-lane-motion": "node scripts/offline-lane-motion-regression.js",
    "test:offline-capture-lane-motion": "node scripts/offline-capture-lane-motion-regression.js",
    "test:foundation": "npm run test:physical && npm run test:offline-rules && npm run test:offline-physical && npm run test:offline-engine && npm run test:offline-coordinator && npm run test:offline-integration && npm run test:offline-route && npm run test:offline-external-route && npm run test:offline-motion && npm run test:offline-motion-execution && npm run test:offline-ownership && npm run test:offline-runtime && npm run test:offline-phase-execution && npm run test:offline-quiet-motion && npm run test:offline-staged-capture-motion && npm run test:offline-lane-motion && npm run test:offline-capture-lane-motion"
  },
  "dependencies": {
    "@google/genai": "*",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-tts-api": "^2.0.2",
    "socket.io": "^4.8.1",
    "stockfish": "^18.0.8",
    "ws": "^8.21.0"
  }
}
