{
  "name": "chess-companion-app",
  "version": "1.0.0",
  "description": "Companion app for autonomous chessboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test:physical-planner": "node scripts/physical-planner-regression.js",
    "test:physical-state": "node scripts/physical-state-regression.js",
    "test:physical-promotion": "node scripts/physical-promotion-regression.js",
    "test:physical": "npm run test:physical-planner && npm run test:physical-state && npm run test:physical-promotion",
    "test:game-settings": "node scripts/game-settings-regression.js",
    "test:mentor-foundation": "node scripts/mentor-foundation-regression.js",
    "test:mentor-chess": "node scripts/mentor-chess-regression.js",
    "test:mentor-tools": "node scripts/mentor-tools-regression.js",
    "test:mentor-engine": "node scripts/mentor-engine-regression.js",
    "test:mentor-live": "node scripts/mentor-live-regression.js",
    "test:mentor-speaker": "node scripts/mentor-speaker-regression.js",
    "test:spotify-relay": "node scripts/spotify-relay-regression.js",
    "test:spotify-mixer": "node scripts/spotify-mixer-regression.js",
    "test:spotify": "npm run test:spotify-relay && npm run test:spotify-mixer",
    "test:mentor-physical": "node scripts/mentor-physical-regression.js",
    "test:mentor-physical-intent": "node scripts/mentor-physical-intent-coaching-regression.js",
    "test:mentor-speaker-tone": "node scripts/mentor-speaker-tone.js",
    "test:mentor-activity": "node scripts/mentor-activity-regression.js",
    "test:mentor-curriculum": "node scripts/mentor-curriculum-regression.js",
    "test:mentor-physical-opening": "node scripts/mentor-physical-opening-regression.js",
    "test:mentor-physical-curriculum": "node scripts/mentor-physical-curriculum-regression.js",
    "test:mentor-physical-handoff": "node scripts/mentor-physical-handoff-regression.js",
    "test:mentor-grounded-coaching": "node scripts/mentor-grounded-coaching-regression.js",
    "test:mentor-live-recovery": "node scripts/mentor-live-recovery-regression.js",
    "test:mentor-live-smoke": "node scripts/mentor-live-smoke.js",
    "test:mentor-browser": "node scripts/mentor-browser-regression.js",
    "test:mentor": "npm run test:game-settings && npm run test:mentor-foundation && npm run test:mentor-chess && npm run test:mentor-tools && npm run test:mentor-engine && npm run test:mentor-live && npm run test:mentor-live-recovery && npm run test:mentor-speaker && npm run test:mentor-physical && npm run test:mentor-physical-intent && npm run test:mentor-activity && npm run test:mentor-curriculum && npm run test:mentor-physical-opening && npm run test:mentor-physical-curriculum && npm run test:mentor-physical-handoff && npm run test:mentor-grounded-coaching && npm run test:mentor-browser",
    "test:online-foundation": "npm run test:physical && npm run test:game-settings",
    "test:foundation": "npm run test:online-foundation",
    "test:music-spectrum": "node scripts/music-spectrum-regression.js",
    "test:exhibition-state": "node scripts/exhibition-regression.js",
    "test:exhibition-browser": "node scripts/exhibition-browser-regression.js",
    "test:exhibition": "npm run test:exhibition-state && npm run test:exhibition-browser",
    "test:autonomous-state": "node scripts/autonomous-regression.js",
    "test:autonomous-firmware": "node scripts/autonomous-firmware-regression.js",
    "test:autonomous-browser": "node scripts/autonomous-browser-regression.js",
    "test:autonomous": "npm run test:autonomous-state && npm run test:autonomous-firmware && npm run test:autonomous-browser",
    "test:ultra-engine": "node scripts/ultra-regression.js",
    "test:ultra-browser": "node scripts/ultra-browser-regression.js",
    "test:ultra": "npm run test:ultra-engine && npm run test:ultra-browser"
  },
  "dependencies": {
    "@google/genai": "1.44.0",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-tts-api": "^2.0.2",
    "socket.io": "^4.8.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
